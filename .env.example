DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,officeflow.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://officeflow.example.com
DJANGO_TIME_ZONE=Asia/Kolkata

POSTGRES_DB=officeflow
POSTGRES_USER=officeflow
POSTGRES_PASSWORD=officeflow_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://officeflow:officeflow_password@db:5432/officeflow
REDIS_URL=redis://redis:6379/0

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=OfficeFlow <noreply@example.com>

DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
